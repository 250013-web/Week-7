#include <iostream>
using namespace std;
// version B, p1
int evenOddBit(int n, int& even, int& odd) {
    even = 0;
    odd = 0;
    int p = 0;
    while (n > 0) {
        if (n % 2 == 1) {
            if (p % 2 == 0)
                even++;
            else
                odd++;
        }
        p /= 2;
        p++;

}

int main () {
    int n, x, y;
    cin >> n >> x >> y;
    evenOddBit(n, x, y)
        cout << x << " " << y;
        return 0;
}
